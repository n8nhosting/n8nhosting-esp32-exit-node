# Copy these into Coolify → Environment Variables for the stack.

# GOST Web API (used by GOST UI login)
API_USER=admin
API_PASS=change-me-strong

# Shared secret between the VPS broker and every ESP32 node (long & random)
POOL_TOKEN=change-me-very-long-random

# Admin REST API bearer token (manage users)
ADMIN_TOKEN=change-me-admin-token

# Payment webhook shared secret (PSP -> admin-api)
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# Usage accounting mode: delta (default) or cumulative — calibrate against real
# GOST observer output; see README "Usage accounting".
USAGE_MODE=delta

# Host ports (publish). PROXY_PORT = customer proxy, POOL_PORT = ESP32 uplink.
PROXY_PORT=8080
POOL_PORT=7000

# Secret path segment protecting the GOST->admin-api plugin callbacks
# (/gost/<secret>/auth …). Alphanumeric.
GOST_PLUGIN_SECRET=change-me-plugin-secret

# Broker TLS (server cert + key signed by the private CA that is baked into the
# firmware). Base64 of the PEM files: base64 -w0 broker.crt / broker.key
TLS_CERT_B64=
TLS_KEY_B64=

# Public proxy endpoint shown in the dashboard's copyable connection strings.
PROXY_PUBLIC_HOST=210.246.215.196
PROXY_PUBLIC_PORT=3128

# Key for reversible credential storage (so the dashboard can show user:pass).
# base64 of 32 random bytes:  openssl rand -base64 32
# If left blank, a key is derived from ADMIN_TOKEN.
CRED_KEY=

# Number of per-device slot proxies gost exposes (ports 3131..3130+SLOT_COUNT).
SLOT_COUNT=30
# Shared secret gost uses to authenticate to the broker per slot; alphanumeric.
SLOT_SECRET=change-me-alphanumeric
# Object downloaded through a device's slot to measure its capacity.
SPEEDTEST_URL=https://flash.jbacteam.com/speedtest.bin

# Customer portal: HTTPS URL on this admin-api, normalized to /portal/.
# Leave unset until email/Turnstile are configured. Never commit real secrets.
PORTAL_BASE_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
EMAIL_FROM=
RESEND_API_KEY=
# Optional operator recipient for new system/device alert transitions.
OPS_ALERT_EMAIL=

# Stripe Checkout (card + PromptPay enabled in Stripe Dashboard).
# Start with test keys and an HTTPS webhook /webhook/stripe on admin-api.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Manual bank transfer: private slip upload and explicit admin review.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
SLIP_STORAGE_MAX_BYTES=536870912

# Optional exact trusted reverse-proxy CIDRs; empty ignores X-Forwarded-For.
PORTAL_TRUSTED_PROXY_CIDRS=
