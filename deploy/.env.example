# Copy these into Coolify → Environment Variables for the stack.

# GOST Web API (used by GOST UI login)
API_USER=admin
API_PASS=change-me-strong

# Shared secret between the VPS broker and every ESP32 node (long & random)
POOL_TOKEN=change-me-very-long-random

# Admin REST API bearer token (manage users)
ADMIN_TOKEN=change-me-admin-token

# Payment webhook shared secret (PSP -> admin-api)
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# Usage accounting mode: delta (default) or cumulative — calibrate against real
# GOST observer output; see README "Usage accounting".
USAGE_MODE=delta

# Host ports (publish). PROXY_PORT = customer proxy, POOL_PORT = ESP32 uplink.
PROXY_PORT=8080
POOL_PORT=7000
