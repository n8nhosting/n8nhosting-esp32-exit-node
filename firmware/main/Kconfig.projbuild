menu "Example Configuration"

    config STORE_HISTORY
        bool "Store command history in flash"
        default y
        help
            Linenoise line editing library provides functions to save and load
            command history. If this option is enabled, initalizes a FAT filesystem
            and uses it to store command history.

endmenu

menu "NAT Router Uplink"

    choice UPLINK_TYPE
        prompt "Uplink interface"
        default WIFI_STA_UPLINK
        config WIFI_STA_UPLINK
            bool "WiFi STA"
        config ETH_UPLINK
            bool "Ethernet (LAN8720)"
    endchoice

    config ETH_MDC_GPIO
        int "ETH MDC GPIO"
        default 23
        depends on ETH_UPLINK

    config ETH_MDIO_GPIO
        int "ETH MDIO GPIO"
        default 18
        depends on ETH_UPLINK

    config ETH_PHY_ADDR
        int "ETH PHY address"
        default 1
        depends on ETH_UPLINK

    config ETH_PHY_POWER_GPIO
        int "ETH PHY power GPIO (-1 for none)"
        default 16
        depends on ETH_UPLINK

    config ETH_RMII_CLK_OUTPUT_GPIO
        int "RMII clock output GPIO (-1 = input from PHY)"
        default -1
        depends on ETH_UPLINK
        help
            Set to the GPIO number on which the ESP32 should generate the 50 MHz
            RMII reference clock (e.g. GPIO 17 for the Olimex ESP32-POE-ISO).
            Leave at -1 when the PHY provides the clock (e.g. WT32-ETH01).

endmenu

menu "MQTT Home Assistant"

    config MQTT_HOMEASSISTANT
        bool "Enable MQTT Home Assistant integration"
        default y
        help
            Publishes router telemetry to an MQTT broker with
            Home Assistant auto-discovery. Adds ~58 KB flash.
            RAM is only used when a broker is configured and enabled.

    config MQTT_HA_BUFFER_SIZE
        int "MQTT buffer size (bytes)"
        default 1024
        depends on MQTT_HOMEASSISTANT

    config MQTT_DEFAULT_INTERVAL
        int "Default publish interval (seconds)"
        default 30
        depends on MQTT_HOMEASSISTANT
        range 5 3600

endmenu

menu "Exit node build"

    # Every gate defaults to today's behaviour so the other upstream targets
    # build unchanged; firmware/sdkconfig.defaults.exitnode flips them for the
    # exit-node boards (ESP32-S3 N16R8, ESP32-C3 Super Mini).

    config FEATURE_OLED
        bool "Build the OLED status display driver and set_oled commands"
        default y

    config FEATURE_PCAP
        bool "Build PCAP packet capture (TCP 19000, pcap command, web settings)"
        default y
        help
            An exit node must not capture customer traffic, and the capture
            hooks sit on the packet path; exit-node builds turn this off.

    config FEATURE_MDNS
        bool "Build the mDNS responder (<hostname>.local)"
        default y
        depends on !IDF_TARGET_ESP32C5
        help
            Disabled on ESP32-C5 to keep the image inside the app partition,
            and in exit-node builds to save RAM (nothing resolves the name).

    config WEB_SETUP_PORTAL_ONLY
        bool "Web UI is only the WiFi setup portal, alive while the setup AP is up"
        default n
        help
            Registers just the Getting Started page (/, /setup, /scan) and
            stops the HTTP server and captive DNS once the uplink is up (the
            rproxy AP policy restarts them when the AP comes back). The
            management pages (config, mappings, firewall, VPN, OTA upload,
            config import/export) are not built.

    config LED_GPIO_DEFAULT
        int "Status LED GPIO when NVS has no led_gpio (-1 = none)"
        default -1
        range -1 48

    config LED_LOWACTIVE_DEFAULT
        bool "Status LED is active-low when NVS has no led_lowactive"
        default n

endmenu