# ESP32-C3 Super Mini overlay (ESP32-C3FN4: 4 MB embedded flash, 400 KB SRAM,
# no PSRAM, single core 160 MHz, USB-Serial/JTAG, blue LED on GPIO8 active-low).
# Apply after sdkconfig.defaults, sdkconfig.defaults.esp32c3 and
# sdkconfig.defaults.exitnode; before sdkconfig.prov. Numbers come from the
# 2026-10-21 spike on the real board (docs/superpowers/specs/2026-10-21-esp32c3-exit-node-design.md §5):
# the S3 configuration left 1.3 KB of heap, this one ~110 KB idle.

# --- flash: 4 MB, two 1,984 KB OTA slots, no FAT storage (history is off) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_c3_4mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_c3_4mb.csv"
CONFIG_STORE_HISTORY=n

# --- RAM diet: code in flash, not IRAM (the S3 defaults pinned 110 KB of
# WiFi/lwIP code in RAM); size-optimised build ---
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n

# --- WiFi buffer pools (spike v2 values; do not raise without a measurement) ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=10
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=4

# --- mux link: 4 streams, 8 KB window, 4 KB frames, one dialer ---
# window x streams + per-socket TCP buffers must fit next to the ~45 KB TLS
# link with >= 20 KB to spare under full load (acceptance, spec §8).
CONFIG_RPROXY_MAX_STREAMS=4
CONFIG_RPROXY_MUX_WINDOW=8192
CONFIG_RPROXY_MUX_FRAME=4096
CONFIG_RPROXY_DIALERS=1
CONFIG_RPROXY_DIALER_STACK=3584
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=24
# outgoing TLS records 4 KB (one frame); incoming stays 16 KB (TLS peers, OTA via CDN)
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# --- board: blue LED on GPIO8, lit when the pin is low ---
CONFIG_LED_GPIO_DEFAULT=8
CONFIG_LED_LOWACTIVE_DEFAULT=y
